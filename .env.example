# Fase 1 uses the `claude` CLI's existing login (run `claude login` once) —
# no API key is required for the default provider. Same for Gemini (via the
# `agy` Antigravity CLI) and the local Qwen model (via Ollama).
#
# Everything below is optional and costs real money per call — none of it
# is required for david-agent to work. Only set what you actually want to
# pay for. Never commit a filled-in .env.

# DeepSeek — https://platform.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# OpenRouter — https://openrouter.ai
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# Any other OpenAI Chat Completions-compatible endpoint (local gateway, etc.)
# OPENAI_COMPATIBLE_NAME=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
